{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/main.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:__route*", "destination": "/api/main?__p=:__route*" },
    { "source": "/_blob/:id", "destination": "/api/main?__blob=:id" }
  ],
  "headers": [
    { "source": "/seed-images/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
